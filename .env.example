# ===== 后端环境变量示例：复制成仓库根 .env 即可（settings.py 会自动加载）=====
# 复制：Copy-Item .env.example .env

# --- LLM（必填：缺了分类/作答会直接报错）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL=deepseek-chat

# --- 状态库：PostgresSaver（连不上自动回退 SQLite）---
AGENT_CHECKPOINT_BACKEND=postgres
DATABASE_URL=postgresql://smartdesk:smartdesk@localhost:5432/smartdesk

# --- 向量库：Milvus（必须启动；连不上会直接报错，不再本地兜底）---
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=smartdesk_kb

# --- Embedding & Rerank（必填：缺了检索会直接报错；默认复用同一个 DASHSCOPE_API_KEY）---
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
# Cross-Encoder 精排：Milvus RRF 粗排取 RERANK_CANDIDATE_K 条 → gte-rerank-v2 重排取 top-k（设 false 可退回纯 RRF）
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RERANK_CANDIDATE_K=10

# --- PDF 解析：MinerU 官方 SDK（mineru-open-sdk）---
# flash 模式免登录可用（<=20 页，排队可能较慢）；precision 模式必须配 token
# token 到 https://mineru.net/ 创建，填在下面（不要提交到 git）
MINERU_API_KEY=
MINERU_MODE=flash
MINERU_OCR=false
MINERU_LANGUAGE=ch
MINERU_TIMEOUT=300
# 待入库的 PDF 目录（ingest_docs.py 默认扫这里）
KB_SOURCE_DIR=docs/kb/pdf

# --- MCP 工单服务：stdio（默认，子进程）或 memory（进程内，受限环境/CI 用）---
# 留空 = 先试 stdio，起不来自动降级 memory
TICKET_MCP_TRANSPORT=
# 工单库路径，默认 .data/tickets.sqlite
TICKET_DB_PATH=